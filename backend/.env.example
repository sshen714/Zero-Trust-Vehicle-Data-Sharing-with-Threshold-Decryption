# 本檔案為設定範本，不含實際憑證，可以提交到 Git。
# 後續設定時複製成 backend/.env，再填入自己的值。
# 不可提交實際 .env，也不要將密碼或 Secret 放入前端。

# MySQL 伺服器：本機開發使用 127.0.0.1，預設埠為 3306。
DB_HOST=127.0.0.1
DB_PORT=3306

# 資料庫與專用帳號需另外在 MySQL 建立；填寫本檔不會自動建立。
# 建議使用專案專用帳號，避免以 root 連線。
DB_NAME=vehicle_data_sharing
DB_USER=vehicle_app

# 替換成該 MySQL 帳號的實際密碼。
DB_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD

# JWT 簽章秘密：必須使用獨立隨機值，不可與資料庫密碼共用。
# 啟用虛擬環境後，可執行以下指令產生，再填入 JWT_SECRET：
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
# 後端將要求至少 32 UTF-8 bytes，並拒絕以下佔位值。
# 更換 Secret 後，舊 JWT 將無法通過驗證。
JWT_SECRET=REPLACE_WITH_GENERATED_RANDOM_SECRET

# JWT 有效時間（分鐘）：預計預設 15，允許 1–60。
# 過期後需要重新登入；這個設定不代表已有更新 token 的功能。
ACCESS_TOKEN_EXPIRE_MINUTES=15

# 允許呼叫後端的前端 origin，以逗號分隔。
# origin 包含協定、主機與埠，不包含頁面路徑或結尾斜線。
# localhost 與 127.0.0.1 是不同 origin，因此都列出。
# 正式部署時改成實際前端 origin，不使用萬用字元 *。
# CORS 不取代 JWT 驗證或角色權限檢查。
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

SPEED_KEY=
LOCATION_KEY=
PLATE_KEY=

# 車主下載 OTP 郵件；設定於本機 .env，修改後重新啟動後端。
# SMTP_SECURITY 可使用 starttls（通常 587）或 ssl（通常 465）。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
